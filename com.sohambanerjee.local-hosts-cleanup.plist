<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sohambanerjee.local-hosts-cleanup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/PrivilegedHelperTools/com.sohambanerjee.local-hosts-cleanup</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>20</integer>
    <key>StandardOutPath</key>
    <string>/var/log/local-hosts-cleanup.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/local-hosts-cleanup.log</string>
</dict>
</plist>
